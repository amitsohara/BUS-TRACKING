# ====================================================================
# SURAKSHAVAHAN ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ====================================================================
# Copy this file to .env and populate with real production credentials.
# NEVER commit .env files containing real secrets to source control.

# Server Environment & Network
NODE_ENV="development" # Set to "production" in live deployment
PORT="3000"
APP_URL="http://localhost:3000"
TIMEZONE="Asia/Kolkata"

# Authentication & JWT Security (Server-Side Only)
# In production, JWT_SECRET must be at least 32 random characters with high entropy
# Generate via: openssl rand -base64 32
JWT_SECRET="YOUR_SECURE_RANDOM_256BIT_SECRET_KEY_MINIMUM_32_CHARS"
JWT_SECRET_PREVIOUS="" # Optional key overlap window during rotation
JWT_EXPIRES_IN="2h" # Default session expiration duration

# Sample Seeding Control (Safety Guard)
SEED_SAMPLE_DATA="false" # Must be "false" in production (Server will refuse to boot if true in production)

# Database Configuration (Server-Side Only)
# Persistent SQLite storage path
SQLITE_DB_PATH="./data/schoolbus.db"

# AI Service Integration (Server-Side Only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Third-Party Map Provider (Optional)
GOOGLE_MAPS_API_KEY="" # Leave empty for free OpenStreetMap tiles

# Push Notifications (Optional - Firebase FCM Service Account)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH="" # Path to service account JSON file

# SMS Gateway Integration (Optional - Indian Parent Alerts)
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID=""
