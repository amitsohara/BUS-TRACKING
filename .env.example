# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT="3000"
NODE_ENV="development"
TIMEZONE="Asia/Kolkata"

# Authentication & Security
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_RANDOM"
JWT_EXPIRES_IN="12h"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Database Configuration (Persistent SQLite storage path or Postgres connection)
SQLITE_DB_PATH="./data/schoolbus.db"

# Optional External Map Provider (defaults to OpenStreetMap tiles if not provided)
GOOGLE_MAPS_API_KEY=""

# Optional Firebase Cloud Messaging (FCM) credentials path for Phase 2 mobile push
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=""

# SMS Gateway (e.g., MSG91 or Fast2SMS for Indian Parent Alerts)
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID=""
